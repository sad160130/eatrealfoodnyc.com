generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// Advertising label only. Null means the restaurant is not a partner.
/// Must never affect rating, reviews, inspection_grade, inspection_score,
/// dietary_tags, is_hidden_gem, Health Score, or organic sort order.
enum PartnerStatus {
  partner
  sponsored

  @@map("partner_status")
}

model Restaurant {
  id               Int      @id @default(autoincrement())
  name             String
  slug             String   @unique
  type             String?
  borough          String?
  neighborhood     String?
  address          String
  street           String?
  city             String?
  state            String?
  latitude         Float?
  longitude        Float?
  rating           Float?
  reviews          Int?     @default(0)
  price_range      Int?
  dietary_tags     String?
  inspection_grade String?
  inspection_date  String?
  inspection_score Int?
  description      String?
  phone            String?
  website          String?
  working_hours    String?
  photo            String?
  street_view      String?
  business_status  String?  @default("OPERATIONAL")
  is_hidden_gem    Boolean  @default(false)
  is_published     Boolean  @default(false)
  isVerified       Boolean  @default(false) @map("is_verified")
  /// Paid placement label. Leave null. Do not backfill.
  /// A non-null value must not change rating, inspection grade, Health Score,
  /// dietary tags, hidden-gem status, or organic sort order.
  partner_status   PartnerStatus?
  priorityRank     Int      @default(0)     @map("priority_rank")
  email            String?
  company_facebook  String?
  company_instagram String?
  company_linkedin  String?
  company_x         String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  /// Postgres tsvector column powering /api/search (FTS via GIN index).
  /// Managed by DB trigger; Prisma can't query it directly — queries use
  /// raw SQL. Declared here so prisma db push doesn't drop it.
  search_vector Unsupported("tsvector")?

  @@index([borough])
  @@index([neighborhood])
  @@index([rating(sort: Desc)])
  @@index([borough, neighborhood])
  @@index([is_hidden_gem])
  @@index([is_published])
  @@index([inspection_grade])
  @@index([priorityRank(sort: Desc), rating(sort: Desc)])
  @@map("restaurants")
}

model NeighborhoodContent {
  id           Int      @id @default(autoincrement())
  borough      String
  neighborhood String
  intro        String?
  faqs         String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([borough, neighborhood])
  @@map("neighborhood_content")
}

model Review {
  id               String   @id @default(cuid())
  // Link to restaurant by slug (matches restaurants.slug) and place_id
  restaurant_slug  String
  place_id         String
  restaurant_name  String?

  // Google review identity
  google_review_id String   @unique
  stars            Int
  reviewer_name    String?
  is_local_guide   Boolean  @default(false)
  published_at     DateTime?
  published_ago    String?
  likes_count      Int      @default(0)
  text             String
  owner_response   String?
  review_url       String?

  created_at       DateTime @default(now())

  @@index([restaurant_slug])
  @@index([place_id])
  @@index([restaurant_slug, stars])
  @@map("reviews")
}

/// Anonymous diner notes from the restaurant-page experience form.
/// Rows stay `pending` until a person reviews them. The table is created
/// by prisma/migrations/20261115180000_user_submissions and by the
/// idempotent script src/scripts/create-user-submissions-table.ts.
/// Weekly "Grade A Eats This Week" signups. confirmed stays false until
/// a confirmation step exists. No third-party email service is wired up.
model NewsletterSubscriber {
  id          Int      @id @default(autoincrement())
  email       String   @unique
  source_path String
  confirmed   Boolean  @default(false)
  created_at  DateTime @default(now())

  @@map("newsletter_subscribers")
}

/// Catering requests from /catering. status stays "new" until a person routes the lead.
/// No payment is collected here.
model CateringLead {
  id              Int      @id @default(autoincrement())
  name            String
  email           String
  phone           String
  event_date      DateTime @db.Date
  headcount       Int
  place           String
  dietary_needs   String   @default("")
  budget          String   @default("")
  notes           String   @default("")
  restaurant_slug String?
  source_path     String
  consent         Boolean  @default(false)
  status          String   @default("new")
  created_at      DateTime @default(now())

  @@index([status])
  @@index([event_date])
  @@map("catering_leads")
}

model UserSubmission {
  id               Int      @id @default(autoincrement())
  restaurant_slug  String
  restaurant_name  String   @default("")
  submission_type  String   @default("experience")
  content          String
  status           String   @default("pending")
  created_at       DateTime @default(now())

  @@index([restaurant_slug])
  @@index([status])
  @@map("user_submissions")
}
